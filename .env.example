# PostgreSQL superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# Airflow metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=your_airflow_password_here
AIRFLOW_UID=1000

# Airflow web UI
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=your_admin_password_here
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=your_secret_key_here

# Data Warehouse (Bronze / Silver / Gold)
DWH_USER=minhdwh
DWH_PASSWORD=your_dwh_password_here
DWH_DB=flight_dwh

DWH_HOST=postgres
DWH_PORT=5432

# Metabase metadata DB
METABASE_DB_USER=metabase_user
METABASE_DB_PASSWORD=your_metabase_password_here
METABASE_DB=metabase
